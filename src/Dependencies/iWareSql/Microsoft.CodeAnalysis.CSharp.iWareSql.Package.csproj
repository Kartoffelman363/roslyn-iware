<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(NetRoslyn);netstandard2.0</TargetFrameworks>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- This folder now holds files with different dependency requirements
         (compiler-internal vs IDE/completion-layer - see the .projitems file
         for details), so we can't let the SDK's default "**/*.cs" globbing
         compile them all together as one standalone assembly. Only
         DbConnection.cs has no Roslyn-internal dependencies and can stand on
         its own, so that's the only thing this packing project builds. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <!-- NuGet -->
    <IsPackable>true</IsPackable>
    <IsSourcePackage>true</IsSourcePackage>
    <PackageId>Microsoft.CodeAnalysis.CSharp.iWareSql</PackageId>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <PackageDescription>
      Package containing iWare SQL database connection/config resolution shared by the C# compiler and C# features layers.
    </PackageDescription>
    <!-- Remove once https://github.com/NuGet/Home/issues/8583 is fixed -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="DbConnection.cs" />
    <Compile Include="Resolver.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" />
  </ItemGroup>
</Project>